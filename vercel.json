{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?__url=/api/$1"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/dados",
      "destination": "/dados.html"
    },
    {
      "source": "/link/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/p/(.*)",
      "destination": "/index.html"
    }
  ]
}
